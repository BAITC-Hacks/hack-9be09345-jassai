# Environment variables; no automatic .env loading. Launcher may set these.
# Default data directory: %LOCALAPPDATA%/CareerQuest/instances/hack-9be09345-jassai
# CAREERQUEST_DATA_DIR=C:/Users/your-name/AppData/Local/CareerQuest/instances/hack-9be09345-jassai
# CAREERQUEST_BOOTSTRAP_TOKEN=<random one-time token supplied by launcher>
# CAREERQUEST_RECOMMENDER=app.ai.provider:recommend
# CAREERQUEST_STATIC_DIR=<absolute directory containing index.html and assets>
# CAREERQUEST_AI_TIMEOUT=9
# Empty installations load starter-data automatically. Use off for a blank dataset,
# or an absolute folder with the four canonical JSON/CSV filenames for another seed.
# Existing datasets are never overwritten on startup.
# CAREERQUEST_SEED_DATA_DIR=off

# Companion conversation. These configure the server process, not the browser.
# CAREERQUEST_COMPANION_PROVIDER=auto
# OPENAI_COMPANION_MODEL=gpt-6-luna
# NVIDIA_COMPANION_MODEL=meta/llama-3.1-8b-instruct
# Set OPENAI_API_KEY / NVIDIA_API_KEY through secure process configuration.
# Never put a real key in this example or commit a local .env.
